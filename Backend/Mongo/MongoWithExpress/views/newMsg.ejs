<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>New Msg</title>
    </head>
    <body>
        <h3>Write new message</h3>
        <form method="post" action="/chats/new">
            <input name="from" placeholder="Enter sender name" />
            <input name="to" placeholder="Enter receiver name" />
            <textarea name="msg" placeholder="Enter message"></textarea>
            <button>Send</button>
        </form>
    </body>
</html>
